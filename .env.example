# Local single-user POC. Linux, Node.js >= 22.13 and local Docker.
# Copy to .env; fill the selected key in a local editor, never in Git or chat.
PORT=3000
DATA_DIR=./data/poc
AIDER_DOCKER_IMAGE=paulgauthier/aider:v0.86.2
AIDER_MODEL=anthropic/claude-sonnet-4-6
AIDER_TIMEOUT_SECONDS=600
ANTHROPIC_API_KEY=
# Alternative: AIDER_MODEL=openai/<supported-model>
OPENAI_API_KEY=
# No cost tracking or spending cap: set limits with the model provider.
# Prompts and relevant project source are sent to that provider.
