# Node.js >= 22.13 (native SQLite). Linux + local Docker are required for Aider.
# The root engine/ template is never modified; projects use private copies.
# Copy to .env locally. Never commit real secrets or paste them into a chat.
# Existing installations: complete README.md migration steps BEFORE upgrading.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
# Set to loopback ONLY behind a trusted local reverse proxy which overwrites X-Forwarded-For.
TRUST_PROXY=
DATA_DIR=./data

# Maximum reserved budget per generation; clients may choose a lower positive integer.
# Successful publication charges the Aider cost estimate, rounded up for the whole request.
# Failed/timed-out/no-change jobs cost the client zero; provider costs remain the operator's.
GENERATION_MAX_CREDITS=200
# Micro-USD of estimated AI usage per platform credit: 10000 = USD 0.01.
# Not a token count, retail EUR price, exchange rate or refundable cash value.
AI_MICRO_USD_PER_CREDIT=10000

# Base entitlements without a qualifying paid subscription; not commercial offers.
MAX_PROJECTS_PER_USER=2
# Per-file upload limit: 20 MiB. Global REGISTERED uploads per user: 500 MiB.
# Shared across projects; excludes template copies, drafts and retained versions.
MAX_ASSET_BYTES=20971520
MAX_USER_ASSET_BYTES=524288000
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=600

# Lemon Squeezy hosted checkout: cards/PayPal subject to provider availability.
# Secrets must remain blank here; supply them only through protected local configuration.
LEMON_API_KEY=
LEMON_WEBHOOK_SECRET=
# Numeric string identifying YOUR store; leave blank until configured.
LEMON_STORE_ID=
# Development default. Set false with live credentials/store/variants in production.
LEMON_TEST_MODE=true
LEMON_PLANS=[]
# Required plan keys: id, name, variantId (positive numeric STRING), credits,
# amount (positive integer EUR cents), currency (exactly "eur"), maxProjects,
# assetQuotaBytes (positive integer bytes, GLOBAL per user).
# id: 1-40 lowercase letters/digits/_/-. name: nonblank, at most 80 characters.
# Each offer needs a distinct variantId. No financial offer is prescribed here.
# Only standard monthly subscriptions, quantity 1, no trial/discount/setup fee/proration.
# amount must match provider unit_price/subtotal; consistent inclusive/exclusive tax is allowed.
# Keep [] until operator-approved offers and matching provider prices exist.

# Optional one-time packs: id, name, variantId, credits, amount, currency.
# Use standard one-time variants and OMIT maxProjects/assetQuotaBytes: packs add no quotas.
LEMON_CREDIT_PACKS=[]

# One Aider invocation in an ephemeral Docker container per request.
# Pull this pinned official image once before starting the server.
# No key, unavailable Docker or missing image: generation disabled (no credits reserved).
AIDER_DOCKER_IMAGE=paulgauthier/aider:v0.86.2
AIDER_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=
# Optional alternative: use AIDER_MODEL=openai/<supported-model> and this key.
OPENAI_API_KEY=
# Only the selected provider key is passed to the container, never payment secrets.
# Claude 3.7 is retired on the Anthropic API; choose a model available to your account.
# The credit budget limits customer charges, NOT the provider's final bill.
# Aider may retry calls internally. Set provider spend limits and alerts separately.
# Missing/zero estimate, invalid changes or over-budget estimate: no publication/debit.
# Prompts and relevant project source are sent to the selected model provider.
